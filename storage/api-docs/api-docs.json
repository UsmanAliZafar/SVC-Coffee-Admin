{
    "openapi": "3.0.0",
    "info": {
        "title": "SVC Ecommerce API",
        "description": "API documentation for Coffee Ecommerce Platform",
        "contact": {
            "email": "support@coffeeecommerce.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Development Server"
        }
