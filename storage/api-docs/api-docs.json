        "/api/categories/{id}/products": {
            "get": {
                "tags": [
                    "Category Products"
                ],
                "summary": "Get products by category",
                "description": "Get all products in a category with advanced filtering options",
                "operationId": "getCategoryProducts",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "is_featured",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "min_price",
                        "in": "query",
                        "schema": {
                            "type": "number",
                            "example": 100
                        }
                    },
                    {
                        "name": "max_price",
                        "in": "query",
                        "schema": {
                            "type": "number",
                            "example": 500
                        }
                    },
                    {
                        "name": "in_stock",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "on_sale",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
